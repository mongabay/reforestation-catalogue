<% content_for :page_title do %>
  Import Organizations from CSV
<% end %>

<div class="trestle-card">
  <div class="trestle-card-header">
    <h2>Import Organizations from CSV</h2>
  </div>
  
  <div class="trestle-card-body">
    <div class="alert alert-info">
      <h4>CSV Format Requirements:</h4>
      <ul>
        <li>The CSV should have headers matching the expected column names</li>
        <li>Required columns: <code>org</code> (organization name)</li>
        <li>Array fields should be comma-separated values</li>
        <li>Boolean fields should be 'true'/'false' or '1'/'0'</li>
        <li>Numeric fields should contain valid numbers</li>
      </ul>
    </div>

    <%= form_tag import_csv_admin_organizations_path, multipart: true, class: "form" do %>
      <div class="form-group">
        <label for="csv_file">Select CSV File</label>
        <%= file_field_tag :csv_file, accept: '.csv', class: "form-control", required: true %>
        <small class="form-text text-muted">Choose a CSV file to import organizations</small>
      </div>

      <div class="form-actions">
        <%= submit_tag "Import CSV", class: "btn btn-primary" %>
        <%= link_to "Cancel", admin_organizations_path, class: "btn btn-secondary" %>
      </div>
    <% end %>
  </div>
</div>

<style>
